---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, getPath } from '@/i18n/utils';

// GitHub Pages serves a single 404.html for all unmatched routes, so this page
// is English-first with a pointer to the Swedish home page.
const t = useTranslations('en');
---
<BaseLayout title={`${t('404.label')} — Emil Freijd`} description={t('404.body')}>
  <section class="not-found">
    <div class="container">
      <p class="section-label">{t('404.label')}</p>
      <h1>{t('404.heading')}</h1>
      <p class="not-found-body">{t('404.body')}</p>
      <div class="not-found-actions">
        <a href={getPath('en', '')} class="btn btn-primary">{t('404.home')}</a>
        <a href={getPath('en', 'contact')} class="btn btn-ghost">{t('404.contact')}</a>
      </div>
      <p class="not-found-sv">
        Letar du på svenska? <a href={getPath('sv', '')}>Gå till startsidan →</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    background: var(--bg);
    padding-top: 80px;
  }
  .not-found .section-label {
    font-size: 4rem;
    font-weight: 800;
    letter-spacing: -.04em;
    color: var(--accent-2);
    margin-bottom: var(--space-4);
    display: block;
  }
  .not-found h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: var(--space-5);
  }
  .not-found-body {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 480px;
    line-height: 1.7;
    margin-bottom: var(--space-10);
  }
  .not-found-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-12);
  }
  .not-found-sv {
    font-size: .875rem;
    color: var(--text-muted);
  }
  .not-found-sv a {
    color: var(--accent-2);
    font-weight: 500;
  }
  .not-found-sv a:hover { text-decoration: underline; }
</style>
