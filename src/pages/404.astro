---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, getPath } from '@/i18n/utils';

// GitHub Pages serves a single 404.html for all unmatched routes, so this page
// is English-first with a pointer to the Swedish home page.
const t = useTranslations('en');
---
<BaseLayout title={`${t('404.label')} — Emil Freijd`} description={t('404.body')} otherLangPath="/sv/" hasTranslation={false} noindex>
  <section class="not-found" id="not-found">
    <div class="container">
      <p class="section-label">{t('404.label')}</p>
      <h1 data-i18n="404.heading">{t('404.heading')}</h1>
      <p class="not-found-body" data-i18n="404.body">{t('404.body')}</p>
      <div class="not-found-actions">
        <a href={getPath('en', '')} class="btn btn-primary" data-local-path="" data-i18n="404.home">{t('404.home')}</a>
        <a href={getPath('en', 'contact')} class="btn btn-ghost" data-local-path="contact" data-i18n="404.contact">{t('404.contact')}</a>
      </div>
      <p class="not-found-sv" id="nf-switch">
        Letar du på svenska? <a href={getPath('sv', '')}>Gå till startsidan →</a>
      </p>
    </div>
  </section>

  <!--
    GitHub Pages serves one 404.html for every unmatched route, so this page is
    built in English. When the missing route is under /sv/, swap the copy to
    Swedish on the client (best effort — true per-language 404 isn't possible
    with a single static 404 document).
  -->
  <script>
    import { ui, type UiKey } from '@/i18n/translations';

    function localizeNotFound() {
      if (!document.getElementById('not-found')) return;
      const lang = /^\/sv(?:\/|$)/.test(location.pathname) ? 'sv' : 'en';
      const copy = ui[lang];
      const home = lang === 'sv' ? '/sv/' : '/';
      document.documentElement.lang = lang;
      document.title = `${copy['404.heading']} — Emil Freijd`;
      for (const name of ['description', 'og:description', 'twitter:description']) {
        document.querySelector(`meta[name="${name}"], meta[property="${name}"]`)?.setAttribute('content', copy['404.body']);
      }
      for (const name of ['og:title', 'twitter:title']) {
        document.querySelector(`meta[name="${name}"], meta[property="${name}"]`)?.setAttribute('content', document.title);
      }
      document.querySelector('meta[property="og:locale"]')?.setAttribute('content', lang === 'sv' ? 'sv_SE' : 'en_GB');
      document.querySelectorAll<HTMLElement>('[data-i18n]').forEach(element => {
        element.textContent = copy[element.dataset.i18n as UiKey];
      });
      document.querySelectorAll<HTMLElement>('[data-i18n-label]').forEach(element => {
        element.setAttribute('aria-label', copy[element.dataset.i18nLabel as UiKey]);
      });
      document.querySelectorAll<HTMLAnchorElement>('[data-local-path]').forEach(link => {
        const path = link.dataset.localPath ?? '';
        link.href = `${home}${path}${path && !path.endsWith('.xml') ? '/' : ''}`;
      });
      document.querySelectorAll<HTMLAnchorElement>('#nav .nav-lang').forEach(link => {
        link.href = lang === 'sv' ? '/' : '/sv/';
        link.title = copy['lang.label'];
        link.textContent = link.closest('.nav-mobile') ? copy['lang.label'] : (lang === 'sv' ? 'EN' : 'SV');
      });
      const switchNote = document.getElementById('nf-switch');
      const switchLink = document.createElement('a');
      switchLink.href = lang === 'sv' ? '/' : '/sv/';
      switchLink.textContent = lang === 'sv' ? 'Go to the homepage →' : 'Gå till startsidan →';
      switchNote?.replaceChildren(lang === 'sv' ? 'Looking for English? ' : 'Letar du på svenska? ', switchLink);
    }
    localizeNotFound();
    document.addEventListener('astro:page-load', localizeNotFound);
  </script>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100vh - 80px);
    min-height: calc(100svh - 80px);
    display: flex;
    align-items: center;
    background: var(--bg);
    padding-top: 80px;
  }
  .not-found .section-label {
    font-size: 4rem;
    font-weight: 800;
    letter-spacing: -.04em;
    color: var(--accent-2);
    margin-bottom: var(--space-4);
    display: block;
  }
  .not-found h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: var(--space-5);
  }
  .not-found-body {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 480px;
    line-height: 1.7;
    margin-bottom: var(--space-10);
  }
  .not-found-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-12);
  }
  .not-found-sv {
    font-size: .875rem;
    color: var(--text-muted);
  }
  .not-found-sv a {
    color: var(--accent-2);
    font-weight: 500;
  }
  .not-found-sv a:hover { text-decoration: underline; }
</style>
