---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, getPath } from '@/i18n/utils';

// GitHub Pages serves a single 404.html for all unmatched routes, so this page
// is English-first with a pointer to the Swedish home page.
const t = useTranslations('en');
---
<BaseLayout title={`${t('404.label')} — Emil Freijd`} description={t('404.body')}>
  <section class="not-found">
    <div class="container">
      <p class="section-label">{t('404.label')}</p>
      <h1 id="nf-heading">{t('404.heading')}</h1>
      <p class="not-found-body" id="nf-body">{t('404.body')}</p>
      <div class="not-found-actions">
        <a href={getPath('en', '')} class="btn btn-primary" id="nf-home">{t('404.home')}</a>
        <a href={getPath('en', 'contact')} class="btn btn-ghost" id="nf-contact">{t('404.contact')}</a>
      </div>
      <p class="not-found-sv" id="nf-switch">
        Letar du på svenska? <a href={getPath('sv', '')}>Gå till startsidan →</a>
      </p>
    </div>
  </section>

  <!--
    GitHub Pages serves one 404.html for every unmatched route, so this page is
    built in English. When the missing route is under /sv/, swap the copy to
    Swedish on the client (best effort — true per-language 404 isn't possible
    with a single static 404 document).
  -->
  <script is:inline>
    (function () {
      if (!location.pathname.replace(/^\//, '').startsWith('sv')) return;
      document.documentElement.lang = 'sv';
      var set = function (id, text) { var el = document.getElementById(id); if (el) el.textContent = text; };
      set('nf-heading', 'Sidan hittades inte.');
      set('nf-body', 'Sidan du letar efter finns inte eller har flyttats.');
      var home = document.getElementById('nf-home');
      if (home) { home.textContent = 'Till startsidan'; home.setAttribute('href', '/sv/'); }
      var contact = document.getElementById('nf-contact');
      if (contact) { contact.textContent = 'Kontakta mig'; contact.setAttribute('href', '/sv/contact/'); }
      var sw = document.getElementById('nf-switch');
      if (sw) sw.innerHTML = 'Looking for English? <a href="/">Go to the homepage →</a>';
    })();
  </script>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100vh - 80px);
    min-height: calc(100svh - 80px);
    min-height: calc(100dvh - 80px);
    display: flex;
    align-items: center;
    background: var(--bg);
    padding-top: 80px;
  }
  .not-found .section-label {
    font-size: 4rem;
    font-weight: 800;
    letter-spacing: -.04em;
    color: var(--accent-2);
    margin-bottom: var(--space-4);
    display: block;
  }
  .not-found h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: var(--space-5);
  }
  .not-found-body {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 480px;
    line-height: 1.7;
    margin-bottom: var(--space-10);
  }
  .not-found-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-12);
  }
  .not-found-sv {
    font-size: .875rem;
    color: var(--text-muted);
  }
  .not-found-sv a {
    color: var(--accent-2);
    font-weight: 500;
  }
  .not-found-sv a:hover { text-decoration: underline; }
</style>
