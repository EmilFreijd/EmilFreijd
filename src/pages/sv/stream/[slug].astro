---
import StreamDetail from '@/components/pages/StreamDetail.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('stream', e => !e.data.draft);
  const enEntries = all.filter(e => e.data.lang !== 'sv');
  return enEntries.map(entry => {
    const svEntry = all.find(e => e.id === `${entry.id}-sv`);
    return {
      params: { slug: entry.id },
      props: { entry: svEntry ?? entry, hasTranslation: Boolean(svEntry) },
    };
  });
}

const { entry, hasTranslation } = Astro.props;
---
<StreamDetail lang="sv" entry={entry} hasTranslation={hasTranslation} />
