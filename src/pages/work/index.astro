---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const allWork = (await getCollection('work', e => !e.data.draft))
  .sort((a, b) => b.data.year - a.data.year);

const sectors = [...new Set(allWork.map(e => e.data.sector))];
---
<BaseLayout
  title="Work — Emil Freijd"
  description="Case studies and program delivery examples from Emil Freijd's career."
>

  <div class="page-hero">
    <div class="container">
      <p class="section-label">Work</p>
      <h1>Case studies.</h1>
      <p>
        A selection of programs I've led — written up with the context, approach,
        and measurable outcomes. No vanity metrics, no vague language.
      </p>
    </div>
  </div>

  <section class="work-list-section">
    <div class="container">

      {allWork.length > 0 ? (
        <div class="work-list">
          {allWork.map(entry => (
            <a href={`${base}work/${entry.slug}`} class="work-item" data-reveal>
              <div class="work-item-meta">
                <span class="work-tag">{entry.data.sector.replace('-', ' ')}</span>
                <span class="work-year">{entry.data.year}</span>
              </div>
              <div class="work-item-body">
                <h2>{entry.data.title}</h2>
                <p>{entry.data.description}</p>
                <div class="work-item-metrics">
                  {entry.data.metrics.map(m => (
                    <span class="metric"><strong>{m.value}</strong> {m.label}</span>
                  ))}
                </div>
                <div class="work-item-tags">
                  {entry.data.tags.map(t => <span class="tag">{t}</span>)}
                </div>
              </div>
              <div class="work-item-arrow">→</div>
            </a>
          ))}
        </div>
      ) : (
        <div class="work-empty">
          <div class="work-empty-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
          </div>
          <h2>Case studies coming soon.</h2>
          <p>
            Writing up 2–3 flagship programs. Each covers the challenge, approach, and measurable outcomes.
          </p>
          <a href={`${base}contact`} class="btn btn-ghost" style="margin-top:1.5rem;">Get in touch in the meantime →</a>
        </div>
      )}

    </div>
  </section>

</BaseLayout>

<style>
  .work-list-section { background: var(--bg); }

  .work-list { display: flex; flex-direction: column; gap: var(--space-4); }

  .work-item {
    display: grid;
    grid-template-columns: 180px 1fr 40px;
    gap: var(--space-8);
    align-items: start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-8);
    transition: all var(--transition);
  }
  .work-item:hover { border-color: rgba(124,106,247,0.3); transform: translateX(4px); box-shadow: 0 8px 30px rgba(0,0,0,0.2); }

  .work-item-meta { display: flex; flex-direction: column; gap: var(--space-2); padding-top: 4px; }
  .work-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-2);
    background: rgba(124,106,247,0.1);
    border: 1px solid rgba(124,106,247,0.2);
    padding: 0.25rem 0.7rem;
    border-radius: 99px;
    text-transform: capitalize;
    width: fit-content;
  }
  .work-year { font-size: 0.85rem; color: var(--text-muted); font-weight: 500; }

  .work-item-body h2 { font-size: 1.25rem; margin-bottom: var(--space-3); }
  .work-item-body p  { font-size: 0.9rem; color: var(--text-muted); line-height: 1.65; margin-bottom: var(--space-4); }
  .work-item-metrics { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-4); }
  .work-item-tags    { display: flex; flex-wrap: wrap; gap: var(--space-2); }

  .metric {
    font-size: 0.8rem;
    color: var(--text-dim);
    background: var(--surface-2);
    border: 1px solid var(--border);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-sm);
  }
  .metric strong { color: var(--accent-2); }

  .work-item-arrow { font-size: 1.25rem; color: var(--text-muted); align-self: center; transition: transform var(--transition); }
  .work-item:hover .work-item-arrow { color: var(--accent-2); transform: translateX(4px); }

  /* Empty state */
  .work-empty {
    text-align: center;
    padding: var(--space-24) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }
  .work-empty-icon { color: var(--text-muted); margin-bottom: var(--space-2); }
  .work-empty h2   { font-size: 1.6rem; }
  .work-empty p    { font-size: 1rem; color: var(--text-muted); max-width: 480px; line-height: 1.7; }

  @media (max-width: 768px) {
    .work-item { grid-template-columns: 1fr; }
    .work-item-arrow { display: none; }
    .work-item-meta { flex-direction: row; align-items: center; }
  }
</style>
