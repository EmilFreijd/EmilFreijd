---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const entries = await getCollection('work', e => !e.data.draft);
  return entries.map(entry => ({
    params: { slug: entry.slug },
    props:  { entry },
  }));
}

const { entry }   = Astro.props;
const { Content } = await render(entry);
const { title, description, sector, year, tags, metrics } = entry.data;
---
<BaseLayout title={`${title} — Emil Freijd`} description={description}>

  <div class="case-hero">
    <div class="container">
      <a href={`${base}work`} class="back-link">← All case studies</a>
      <div class="case-meta">
        <span class="work-tag">{sector.replace('-', ' ')}</span>
        <span class="case-year">{year}</span>
      </div>
      <h1>{title}</h1>
      <p class="case-desc">{description}</p>
      <div class="case-tags">
        {tags.map(t => <span class="tag">{t}</span>)}
      </div>
    </div>
  </div>

  <section class="case-body-section">
    <div class="container">
      <div class="case-grid">

        <!-- Metrics sidebar -->
        <aside class="case-sidebar">
          <div class="metrics-card">
            <h3>At a glance</h3>
            {metrics.map(m => (
              <div class="metric-row">
                <span class="metric-value">{m.value}</span>
                <span class="metric-label">{m.label}</span>
              </div>
            ))}
          </div>
        </aside>

        <!-- MDX content -->
        <article class="case-content prose">
          <Content />
        </article>

      </div>
    </div>
  </section>

  <!-- Next CTA -->
  <section class="case-cta">
    <div class="container">
      <div class="cta-inner">
        <div>
          <h2>Want to work together?</h2>
          <p>If this kind of work is relevant to what you're building, let's talk.</p>
        </div>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <a href="https://www.emilfreijd.se" target="_blank" rel="noopener" class="btn btn-primary">LinkedIn</a>
          <a href={`${base}contact`} class="btn btn-ghost">Get in touch</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Case hero ─────────────────────────────────────────────────── */
  .case-hero {
    padding: 120px 0 var(--space-16);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: var(--space-6);
    transition: color var(--transition);
  }
  .back-link:hover { color: var(--accent-2); }
  .case-meta { display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-5); }
  .work-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-2);
    background: rgba(124,106,247,0.1);
    border: 1px solid rgba(124,106,247,0.2);
    padding: 0.25rem 0.7rem;
    border-radius: 99px;
    text-transform: capitalize;
  }
  .case-year { font-size: 0.85rem; color: var(--text-muted); font-weight: 500; }
  .case-hero h1 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    background: linear-gradient(135deg, #fff 30%, var(--accent-2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--space-5);
  }
  .case-desc { font-size: 1.15rem; color: var(--text-dim); max-width: 680px; line-height: 1.7; margin-bottom: var(--space-6); }
  .case-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }

  /* ── Case body ─────────────────────────────────────────────────── */
  .case-body-section { background: var(--bg); }
  .case-grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  /* Sidebar */
  .case-sidebar { position: sticky; top: 100px; }
  .metrics-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-6);
  }
  .metrics-card h3 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); font-weight: 600; margin-bottom: var(--space-5); }
  .metric-row { padding: var(--space-4) 0; border-bottom: 1px solid var(--border); }
  .metric-row:last-child { border-bottom: none; }
  .metric-value { display: block; font-size: 1.5rem; font-weight: 800; color: var(--accent-2); letter-spacing: -0.02em; }
  .metric-label { display: block; font-size: 0.8rem; color: var(--text-muted); margin-top: 2px; }

  /* Prose content */
  .prose { max-width: 680px; }
  .prose :global(h2) {
    font-size: 1.4rem;
    color: var(--text);
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
  }
  .prose :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: none; }
  .prose :global(p)  { color: var(--text-dim); line-height: 1.75; font-size: 1.025rem; margin-bottom: var(--space-5); }
  .prose :global(ul) { color: var(--text-dim); padding-left: var(--space-6); margin-bottom: var(--space-5); }
  .prose :global(li) { line-height: 1.65; margin-bottom: var(--space-2); }
  .prose :global(strong) { color: var(--text); font-weight: 600; }

  /* ── Case CTA ──────────────────────────────────────────────────── */
  .case-cta { background: var(--surface); border-top: 1px solid var(--border); }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); flex-wrap: wrap; }
  .cta-inner h2 { font-size: 1.8rem; margin-bottom: var(--space-3); }
  .cta-inner p  { color: var(--text-muted); max-width: 400px; }

  /* ── Responsive ────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .case-grid { grid-template-columns: 1fr; }
    .case-sidebar { position: static; }
    .cta-inner { flex-direction: column; }
  }
</style>
