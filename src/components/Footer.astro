---
import { useTranslations, getPath, type Lang } from '@/i18n/utils';
import { GITHUB_URL, LINKEDIN_URL } from '@/consts';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t    = useTranslations(lang);
const year = new Date().getFullYear();
---
<footer>
  <div class="container">
    <div class="footer-inner">
      <span class="footer-logo">Emil Freijd</span>
      <nav class="footer-nav" aria-label={t('footer.navigation')} data-i18n-label="footer.navigation">
        <a href={getPath(lang, 'about')} data-local-path="about" data-i18n="footer.about">{t('footer.about')}</a>
        <a href={getPath(lang, 'stream')} data-local-path="stream" data-i18n="footer.work">{t('footer.work')}</a>
        <a href={getPath(lang, 'contact')} data-local-path="contact" data-i18n="footer.contact">{t('footer.contact')}</a>
        <a href={lang === 'sv' ? '/sv/rss.xml' : '/rss.xml'} data-local-path="rss.xml" data-i18n="footer.rss">{t('footer.rss')}</a>
      </nav>
      <nav class="footer-nav" aria-label={t('footer.profiles')} data-i18n-label="footer.profiles">
        <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
      <p class="footer-copy">© {year} Emil Freijd</p>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding: var(--space-8) 0;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .footer-logo { font-weight: 700; font-size: 0.95rem; color: var(--accent-text); }
  .footer-nav  { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); }
  .footer-nav a {
    font-size: 0.85rem;
    color: var(--text-muted);
    transition: color var(--transition);
  }
  .footer-nav a:hover { color: var(--text); }
  .footer-copy { font-size: 0.85rem; color: var(--text-muted); }
  @media (max-width: 600px) {
    .footer-inner { justify-content: center; text-align: center; }
    .footer-nav   { justify-content: center; }
  }
</style>
