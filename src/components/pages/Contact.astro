---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '@/i18n/utils';
import { FORMSPREE_ID, FORMSPREE_URL, LINKEDIN_URL, CAL_URL } from '@/consts';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<BaseLayout
  lang={lang}
  title={`${t('contact.label')} — Emil Freijd`}
  description={lang === 'sv'
    ? 'Kontakta Emil Freijd — IT-ledare inom plattformar, team och AI.'
    : 'Get in touch with Emil Freijd — IT leader across platforms, teams, and AI.'}
>
  <div class="page-hero">
    <div class="container">
      <p class="section-label">{t('contact.label')}</p>
      <h1>{t('contact.heading')}</h1>
      <p>{t('contact.desc')}</p>
      <div class="contact-fit">
        <p class="contact-fit-heading">{t('contact.fit.heading')}</p>
        <ul>
          <li>{t('contact.fit.1')}</li>
          <li>{t('contact.fit.2')}</li>
          <li>{t('contact.fit.3')}</li>
        </ul>
      </div>
    </div>
  </div>

  <section class="contact-section">
    <div class="container">
      <div class="contact-grid">

        <div class="contact-form-wrap">
          <h2>{t('contact.form.heading')}</h2>
          <p class="contact-form-sub">{t('contact.form.sub')}</p>

          <!-- Shown by Formspree SDK on successful submission -->
          <div data-fs-success class="form-success" role="status" aria-live="polite">
            {t('contact.form.success')}
          </div>

          <!-- Global form-level errors (e.g. rate limit, server error) -->
          <div data-fs-error class="form-error-global" role="alert" aria-live="assertive"></div>

          <form action={FORMSPREE_URL} method="POST" class="contact-form" id="contact-form" data-form-id={FORMSPREE_ID}>
            <!-- Honeypot: hidden from users; Formspree discards submissions where this is filled -->
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
            <div class="form-row">
              <div class="form-group">
                <label for="name">{t('contact.form.name')}</label>
                <input type="text" id="name" name="name"
                  placeholder={t('contact.form.name.ph')}
                  maxlength="100" autocomplete="name" data-fs-field required />
                <span data-fs-error="name" class="field-error"></span>
              </div>
              <div class="form-group">
                <label for="email">{t('contact.form.email')}</label>
                <input type="email" id="email" name="email"
                  placeholder={t('contact.form.email.ph')}
                  maxlength="254" autocomplete="email" data-fs-field required />
                <span data-fs-error="email" class="field-error"></span>
              </div>
            </div>
            <div class="form-group">
              <label for="subject">{t('contact.form.subject')}</label>
              <input type="text" id="subject" name="subject"
                placeholder={t('contact.form.subject.ph')}
                maxlength="160" data-fs-field />
              <span data-fs-error="subject" class="field-error"></span>
            </div>
            <div class="form-group">
              <label for="message">{t('contact.form.message')}</label>
              <textarea id="message" name="message" rows="6"
                placeholder={t('contact.form.message.ph')}
                maxlength="5000" data-fs-field required></textarea>
              <span data-fs-error="message" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-primary form-submit" data-fs-submit-btn>
              {t('contact.form.submit')}
            </button>
            <p class="form-privacy">{t('contact.form.privacy')}</p>
          </form>
          <p class="contact-closing">{t('contact.closing')}</p>
        </div>

        <div class="contact-sidebar">
          <div class="contact-method">
            <h3>{t('contact.li.heading')}</h3>
            <p>{t('contact.li.desc')}</p>
            <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="contact-link">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              {t('contact.li.link')}
            </a>
          </div>
          <div class="contact-method">
            <h3>{t('contact.cal.heading')}</h3>
            <p>{t('contact.cal.desc')}</p>
            <a href={CAL_URL} target="_blank" rel="noopener noreferrer" class="contact-link">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              {t('contact.cal.link')}
            </a>
          </div>
          <div class="contact-note">
            <p><strong>{t('contact.note.label')}</strong> {t('contact.note.body')}</p>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-fit { margin-top:var(--space-6);max-width:560px; }
  .contact-fit-heading { font-size:.85rem;font-weight:600;color:var(--text-dim);margin-bottom:var(--space-3); }
  .contact-fit ul { list-style:none;display:flex;flex-direction:column;gap:var(--space-2); }
  .contact-fit li { font-size:.9rem;color:var(--text-muted);line-height:1.6;padding-left:1.1rem;position:relative; }
  .contact-fit li::before { content:'→';position:absolute;left:0;color:var(--accent);font-size:.75rem; }
  .contact-closing { font-size:.85rem;color:var(--text-muted);margin-top:var(--space-6);font-style:italic; }
  .contact-section { background:var(--bg); }
  .contact-grid { display:grid;grid-template-columns:1fr 320px;gap:var(--space-16);align-items:start; }
  .contact-form-wrap h2 { margin-bottom:var(--space-2); }
  .contact-form-sub { font-size:.9rem;color:var(--text-muted);margin-bottom:var(--space-8); }
  .contact-form { display:flex;flex-direction:column;gap:var(--space-5); }
  .form-row { display:grid;grid-template-columns:1fr 1fr;gap:var(--space-5); }
  .form-group { display:flex;flex-direction:column;gap:var(--space-2); }
  .form-group label { font-size:.85rem;font-weight:600;color:var(--text-dim); }
  .form-group input,.form-group textarea { background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.75rem 1rem;font-size:.95rem;color:var(--text);font-family:inherit;transition:border-color var(--transition);outline:none;resize:vertical; }
  .form-group input::placeholder,.form-group textarea::placeholder { color:var(--text-muted); }
  .form-group input:focus,.form-group textarea:focus { border-color:var(--accent); }
  .form-submit { align-self:flex-start; }
  .form-submit[disabled] { opacity:.6; cursor:not-allowed; }
  .form-privacy { max-width:600px;font-size:.78rem;color:var(--text-muted);line-height:1.6; }

  /* Formspree SDK states */
  .form-success,.form-error-global { display:none; }
  .form-success { font-size:.9rem;color:#4ade80;padding:var(--space-3) var(--space-4);background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);border-radius:var(--radius-sm);margin-bottom:var(--space-5); }
  .form-error-global { font-size:.875rem;color:#f87171;padding:var(--space-3) var(--space-4);background:rgba(248,113,113,.08);border:1px solid rgba(248,113,113,.2);border-radius:var(--radius-sm);margin-bottom:var(--space-5); }
  .field-error { font-size:.8rem;color:#f87171;min-height:1.2em; }
  [data-fs-field][aria-invalid="true"] { border-color:#f87171 !important; }
  [data-fs-success][data-fs-active],[data-fs-error][data-fs-active] { display:block; }
  .contact-sidebar { display:flex;flex-direction:column;gap:var(--space-6); }
  .contact-method { background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:var(--space-6); }
  .contact-method h3 { font-size:.95rem;margin-bottom:var(--space-2); }
  .contact-method p  { font-size:.875rem;color:var(--text-muted);line-height:1.6;margin-bottom:var(--space-4); }
  .contact-link { display:inline-flex;align-items:center;gap:var(--space-2);font-size:.875rem;font-weight:600;color:var(--accent-2);transition:gap var(--transition); }
  .contact-link:hover { gap:var(--space-3); }
  .contact-note { background:var(--surface-2);border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:var(--radius-sm);padding:var(--space-5); }
  .contact-note p { font-size:.85rem;color:var(--text-muted);line-height:1.65; }
  .contact-note strong { color:var(--text-dim); }
  @media (max-width:900px) { .contact-grid { grid-template-columns:1fr; } }
  @media (max-width:600px) { .form-row { grid-template-columns:1fr; } }
</style>

<script>
  import { initForm } from '@formspree/ajax/dist/index.mjs';

  // Re-init on every (view-transition) navigation — the form element is
  // replaced on each swap, and module scripts only run once per session.
  // The form id lives in src/consts.ts and reaches the client via data-form-id.
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form');
    if (!form?.dataset.formId) return;
    initForm({ formElement: '#contact-form', formId: form.dataset.formId, useDefaultStyles: false });
  });
</script>
