---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, getPath, localizeStream, type Lang } from '@/i18n/utils';
import { getCollection } from 'astro:content';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const allStream = await getCollection('stream', e => !e.data.draft);
const items = localizeStream(allStream, lang)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const kindLabel: Record<string, string> = {
  case:    t('stream.kind.case'),
  project: t('stream.kind.project'),
  essay:   t('stream.kind.essay'),
  update:  t('stream.kind.update'),
};
---
<BaseLayout lang={lang} title={t('meta.stream.title')} description={t('meta.stream.desc')}>

  <section class="stream-hero page-hero">
    <div class="container">
      <p class="section-label">{t('stream.label')}</p>
      <h1>{t('stream.heading')}</h1>
      <p class="stream-intro">{t('stream.desc')}</p>
      <div class="filter-bar">
        <button class="filter-btn active" data-filter="all" aria-pressed="true">{t('stream.filter.all')}</button>
        <button class="filter-btn" data-filter="timeless" aria-pressed="false">{t('stream.filter.timeless')}</button>
      </div>
    </div>
  </section>

  <section class="stream-section">
    <div class="container">
      {items.length > 0 ? (
        <ul class="stream-list" id="stream-list">
          {items.map(item => (
            <li class="stream-item" data-timeless={String(item.data.timeless)}>
              <span class="item-year">{item.data.date.getFullYear()}</span>
              <div class="item-body">
                <div class="item-meta">
                  <span class="kind-tag" data-kind={item.data.kind}>
                    {kindLabel[item.data.kind]}
                  </span>
                  {item.data.sector && (
                    <span class="item-sector">{item.data.sector.replaceAll('-', ' ')}</span>
                  )}
                </div>
                <a href={getPath(lang, `stream/${item.id}`)} class="item-title">
                  {item.data.title}
                </a>
                <p class="item-desc">{item.data.description}</p>
                <a href={getPath(lang, `stream/${item.id}`)} class="item-cta">
                  {t('stream.read')}
                </a>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="stream-empty">{t('stream.empty')}</p>
      )}
    </div>
  </section>

</BaseLayout>

<script>
  // Re-bind on every (view-transition) navigation — module scripts only run
  // once per session, so listeners must be re-attached to the swapped DOM.
  function initStreamFilter() {
    const btns  = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLLIElement>('.stream-item');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        btns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        const filter = btn.dataset.filter;
        items.forEach(item => {
          item.hidden = filter === 'timeless' && item.dataset.timeless !== 'true';
        });
      });
    });
  }
  document.addEventListener('astro:page-load', initStreamFilter);
</script>

<style>
  .stream-hero { background: var(--surface); border-bottom: 1px solid var(--border); }
  .stream-intro { color: var(--text-muted); font-size: 1.025rem; max-width: 540px; margin-bottom: var(--space-8); line-height: 1.65; }

  .filter-bar { display: flex; gap: var(--space-2); }
  .filter-btn {
    font-size: .82rem; font-weight: 600;
    padding: .4rem 1.1rem; border-radius: 99px;
    border: 1px solid var(--border); background: transparent;
    color: var(--text-muted); cursor: pointer; transition: all var(--transition);
  }
  .filter-btn:hover { border-color: rgba(124,106,247,.3); color: var(--text); }
  .filter-btn.active { background: rgba(124,106,247,.12); border-color: rgba(124,106,247,.3); color: var(--accent-2); }

  .stream-section { background: var(--bg); }
  .stream-list { list-style: none; }

  .stream-item {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: var(--space-10);
    padding: var(--space-10) 0;
    border-bottom: 1px solid var(--border);
    align-items: start;
  }
  .stream-item:last-child { border-bottom: none; }

  .item-year {
    font-size: .78rem; font-weight: 700; color: var(--text-muted);
    padding-top: .3rem; letter-spacing: .04em;
  }

  .item-body { display: flex; flex-direction: column; gap: var(--space-3); }

  .item-meta { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }

  .kind-tag {
    font-size: .72rem; font-weight: 600;
    padding: .2rem .65rem; border-radius: 99px; border: 1px solid;
  }
  .kind-tag[data-kind="case"]    { color: var(--accent-2); background: rgba(124,106,247,.08); border-color: rgba(124,106,247,.2); }
  .kind-tag[data-kind="project"] { color: #34d399; background: rgba(52,211,153,.08); border-color: rgba(52,211,153,.2); }
  .kind-tag[data-kind="essay"]   { color: #fb923c; background: rgba(251,146,60,.08); border-color: rgba(251,146,60,.2); }
  .kind-tag[data-kind="update"]  { color: var(--text-muted); background: var(--surface); border-color: var(--border); }

  .item-sector { font-size: .75rem; color: var(--text-muted); text-transform: capitalize; }

  .item-title {
    font-size: 1.15rem; font-weight: 700; color: var(--text);
    line-height: 1.3; transition: color var(--transition);
  }
  .item-title:hover { color: var(--accent-2); }

  .item-desc { font-size: .9rem; color: var(--text-muted); line-height: 1.65; max-width: 640px; margin: 0; }

  .item-cta { font-size: .85rem; font-weight: 600; color: var(--accent-2); }
  .item-cta:hover { text-decoration: underline; }

  .stream-empty { color: var(--text-muted); padding: var(--space-20) 0; text-align: center; }

  @media (max-width: 600px) {
    .stream-item { grid-template-columns: 1fr; gap: var(--space-3); }
    .item-year { display: none; }
  }
</style>
