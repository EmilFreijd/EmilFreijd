---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, getPath, localizeStream, formatDate, type Lang } from '@/i18n/utils';
import { getCollection } from 'astro:content';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const allStream = await getCollection('stream', e => !e.data.draft);
const items = localizeStream(allStream, lang)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const showFilters = items.some(item => item.data.timeless) && items.some(item => !item.data.timeless);

const kindLabel: Record<string, string> = {
  case:    t('stream.kind.case'),
  project: t('stream.kind.project'),
  essay:   t('stream.kind.essay'),
  update:  t('stream.kind.update'),
};
---
<BaseLayout lang={lang} title={t('meta.stream.title')} description={t('meta.stream.desc')}>

  <section class="stream-hero page-hero">
    <div class="container">
      <h1>{t('stream.heading')}</h1>
      <p class="stream-intro">{t('stream.desc')}</p>
      <a href={`${getPath(lang, '')}rss.xml`} class="stream-rss" data-astro-reload>{t('stream.rss')}</a>
    </div>
  </section>

  <section class="stream-section">
    <div class="container">
      {showFilters && (
        <div class="filter-bar" role="group" aria-label={t('stream.filter.label')} hidden>
          <button type="button" class="filter-btn active" data-filter="all" aria-pressed="true">{t('stream.filter.all')}</button>
          <button type="button" class="filter-btn" data-filter="timeless" aria-pressed="false">{t('stream.filter.timeless')}</button>
        </div>
      )}
      {items.length > 0 ? (
        <ul class="stream-list" id="stream-list">
          {items.map(item => (
            <li class="stream-item" data-timeless={String(item.data.timeless)}>
              <div class="item-meta">
                <span class="kind-tag" data-kind={item.data.kind}>{kindLabel[item.data.kind]}</span>
                {item.data.sector && <span class="item-sector">{t(`stream.sector.${item.data.sector}`)}</span>}
                <time datetime={item.data.date.toISOString().slice(0, 10)}>{formatDate(item.data.date, lang)}</time>
              </div>
              <a href={getPath(lang, `stream/${item.id}`)} class="item-title" lang={item.data.lang}>
                {item.data.title}
              </a>
              <p class="item-desc" lang={item.data.lang}>{item.data.description}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="stream-empty">{t('stream.empty')}</p>
      )}
    </div>
  </section>

</BaseLayout>

<script>
  // Re-bind on every (view-transition) navigation — module scripts only run
  // once per session, so listeners must be re-attached to the swapped DOM.
  function initStreamFilter() {
    const filters = document.querySelector<HTMLElement>('.filter-bar');
    if (!filters || !filters.hidden) return;
    filters.hidden = false;

    const btns = filters.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLLIElement>('.stream-item');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        btns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        const filter = btn.dataset.filter;
        items.forEach(item => {
          item.hidden = filter === 'timeless' && item.dataset.timeless !== 'true';
        });
      });
    });
  }
  document.addEventListener('astro:page-load', initStreamFilter);
</script>

<style>
  .stream-hero { background: var(--surface); border-bottom: 1px solid var(--border); }
  .stream-intro { color: var(--text-muted); font-size: 1.025rem; max-width: 540px; margin-bottom: var(--space-5); line-height: 1.65; }
  .stream-rss { color: var(--accent-2); text-decoration: underline; text-underline-offset: .2em; }

  .filter-bar { display: flex; gap: var(--space-2); margin-bottom: var(--space-4); }
  .filter-bar[hidden], .stream-item[hidden] { display: none; }
  .filter-btn {
    font-size: .82rem; font-weight: 600;
    padding: .4rem 1.1rem; border-radius: 99px;
    border: 1px solid var(--border); background: transparent;
    color: var(--text-muted); cursor: pointer; transition: all var(--transition);
  }
  .filter-btn:hover { border-color: rgba(124,106,247,.3); color: var(--text); }
  .filter-btn.active { background: rgba(124,106,247,.12); border-color: rgba(124,106,247,.3); color: var(--accent-2); }

  .stream-section { background: var(--bg); }
  .stream-list { list-style: none; }

  .stream-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--border);
  }
  .stream-item:last-child { border-bottom: none; }

  .item-meta { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }

  .kind-tag {
    font-size: .72rem; font-weight: 600;
    padding: .2rem .65rem; border-radius: 99px; border: 1px solid;
  }
  .kind-tag[data-kind="case"]    { color: var(--accent-text); background: rgba(124,106,247,.08); border-color: rgba(124,106,247,.2); }
  .kind-tag[data-kind="project"] { color: var(--project-text); background: rgba(52,211,153,.08); border-color: rgba(52,211,153,.2); }
  .kind-tag[data-kind="essay"]   { color: var(--essay-text); background: rgba(251,146,60,.08); border-color: rgba(251,146,60,.2); }
  .kind-tag[data-kind="update"]  { color: var(--text-muted); background: var(--surface); border-color: var(--border); }

  .item-sector, .item-meta time { font-size: .8rem; color: var(--text-muted); }

  .item-title {
    font-size: 1.15rem; font-weight: 700; color: var(--text);
    line-height: 1.3; transition: color var(--transition);
  }
  .item-title:hover { color: var(--accent-2); }

  .item-desc { font-size: .9rem; color: var(--text-muted); line-height: 1.65; max-width: 640px; margin: 0; }

  .stream-empty { color: var(--text-muted); padding: var(--space-20) 0; text-align: center; }

</style>
