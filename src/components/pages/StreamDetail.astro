---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, getPath, type Lang } from '@/i18n/utils';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  lang:  Lang;
  entry: CollectionEntry<'stream'>;
}
const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const { title, description, sector, date, kind, tags, metrics } = entry.data;
const hasSidebar = metrics && metrics.length > 0;

const kindLabel: Record<string, string> = {
  case:    t('stream.kind.case'),
  project: t('stream.kind.project'),
  essay:   t('stream.kind.essay'),
  update:  t('stream.kind.update'),
};

// Procedural cover image — deterministic from slug
function seedRand(slug: string, index: number): number {
  let h = index + 1;
  for (let i = 0; i < slug.length; i++) {
    h = Math.imul(h ^ slug.charCodeAt(i), 0x9e3779b9);
  }
  h ^= h >>> 16;
  return (h >>> 0) / 0xffffffff;
}

const kindRgb: Record<string, string> = {
  case:    '124,106,247',
  project: '52,211,153',
  essay:   '251,146,60',
  update:  '148,163,184',
};
const rgb = kindRgb[kind] || '124,106,247';
const CW = 800, CH = 260, PAD = 70;
const nodes = Array.from({ length: 8 }, (_, i) => ({
  cx: Math.round(seedRand(entry.id, i * 4)     * (CW - PAD * 2) + PAD),
  cy: Math.round(seedRand(entry.id, i * 4 + 1) * (CH - PAD * 2) + PAD),
  r:  Math.round(seedRand(entry.id, i * 4 + 2) * 14) + 5,
  o:  Math.round(seedRand(entry.id, i * 4 + 3) * 40 + 20),
}));
const edges = [[0,1],[1,2],[2,3],[3,4],[0,3],[1,4],[2,5],[4,6],[5,7],[1,6]];
---
<BaseLayout lang={lang} title={`${title} — Emil Freijd`} description={description}>

  <div class="case-hero page-hero">
    <div class="container">
      <a href={getPath(lang, 'stream')} class="back-link">{t('stream.back')}</a>
      <div class="case-meta">
        <span class="kind-tag" data-kind={kind}>{kindLabel[kind]}</span>
        {sector && <span class="case-sector">{sector.replaceAll('-', ' ')}</span>}
        <span class="case-year">{date.getFullYear()}</span>
      </div>
      <h1>{title}</h1>
      <p class="case-desc">{description}</p>
      {tags && tags.length > 0 && (
        <div class="case-tags">{tags.map(tag => <span class="tag">{tag}</span>)}</div>
      )}
    </div>
  </div>

  <div class="post-cover-wrap" aria-hidden="true">
    <svg class="post-cover-svg" viewBox={`0 0 ${CW} ${CH}`} xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id="cfade-l" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0%"   stop-color="var(--surface)" stop-opacity="1"/>
          <stop offset="18%"  stop-color="var(--surface)" stop-opacity="0"/>
        </linearGradient>
        <linearGradient id="cfade-r" x1="0" x2="1" y1="0" y2="0">
          <stop offset="82%"  stop-color="var(--surface)" stop-opacity="0"/>
          <stop offset="100%" stop-color="var(--surface)" stop-opacity="1"/>
        </linearGradient>
        <linearGradient id="cfade-b" x1="0" x2="0" y1="0" y2="1">
          <stop offset="50%"  stop-color="var(--surface)" stop-opacity="0"/>
          <stop offset="100%" stop-color="var(--surface)" stop-opacity="1"/>
        </linearGradient>
      </defs>
      {Array.from({ length: 12 }, (_, x) => (
        <line x1={x * 73} y1="0" x2={x * 73} y2={CH} stroke={`rgb(${rgb})`} stroke-width="0.5" opacity="0.07"/>
      ))}
      {Array.from({ length: 4 }, (_, y) => (
        <line x1="0" y1={y * 87} x2={CW} y2={y * 87} stroke={`rgb(${rgb})`} stroke-width="0.5" opacity="0.07"/>
      ))}
      {edges.map(([a, b]) => (
        <line x1={nodes[a].cx} y1={nodes[a].cy} x2={nodes[b].cx} y2={nodes[b].cy} stroke={`rgb(${rgb})`} stroke-width="1" opacity="0.18"/>
      ))}
      {nodes.map(n => (
        <circle cx={n.cx} cy={n.cy} r={n.r * 3} fill={`rgba(${rgb},0.05)`}/>
      ))}
      {nodes.map(n => (
        <circle cx={n.cx} cy={n.cy} r={n.r} fill={`rgba(${rgb},${(n.o / 100).toFixed(2)})`}/>
      ))}
      <rect width={CW} height={CH} fill="url(#cfade-l)"/>
      <rect width={CW} height={CH} fill="url(#cfade-r)"/>
      <rect width={CW} height={CH} fill="url(#cfade-b)"/>
    </svg>
  </div>

  <section class="case-body-section">
    <div class="container">
      <div class={`case-grid${hasSidebar ? ' has-sidebar' : ''}`}>
        {hasSidebar && (
          <aside class="case-sidebar">
            <div class="metrics-card">
              <h3>{t('case.glance')}</h3>
              {metrics!.map(m => (
                <div class="metric-row">
                  <span class="metric-value">{m.value}</span>
                  <span class="metric-label">{m.label}</span>
                </div>
              ))}
            </div>
          </aside>
        )}
        <article class="case-content prose">
          <Content />
        </article>
      </div>
    </div>
  </section>

  <section class="case-cta">
    <div class="container">
      <div class="cta-inner">
        <div>
          <h2>{t('case.cta.heading')}</h2>
          <p>{t('case.cta.desc')}</p>
        </div>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <a href="https://www.linkedin.com/in/emilfreijd" target="_blank" rel="noopener noreferrer" class="btn btn-primary">LinkedIn</a>
          <a href={getPath(lang, 'contact')} class="btn btn-ghost">{t('cta.ghost')}</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .case-hero { background: var(--surface); }
  .post-cover-wrap { background: var(--surface); border-bottom: 1px solid var(--border); height: 200px; overflow: hidden; }
  .post-cover-svg  { width: 100%; height: 100%; display: block; }
  .back-link { display: inline-block; font-size: .875rem; color: var(--text-muted); margin-bottom: var(--space-6); transition: color var(--transition); }
  .back-link:hover { color: var(--accent-2); }
  .case-meta { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; margin-bottom: var(--space-5); }

  .kind-tag {
    font-size: .72rem; font-weight: 600;
    padding: .25rem .7rem; border-radius: 99px; border: 1px solid;
  }
  .kind-tag[data-kind="case"]    { color: var(--accent-2); background: rgba(124,106,247,.08); border-color: rgba(124,106,247,.2); }
  .kind-tag[data-kind="project"] { color: #34d399; background: rgba(52,211,153,.08); border-color: rgba(52,211,153,.2); }
  .kind-tag[data-kind="essay"]   { color: #fb923c; background: rgba(251,146,60,.08); border-color: rgba(251,146,60,.2); }
  .kind-tag[data-kind="update"]  { color: var(--text-muted); background: var(--surface); border-color: var(--border); }

  .case-sector { font-size: .82rem; color: var(--text-muted); text-transform: capitalize; font-weight: 500; }
  .case-year   { font-size: .82rem; color: var(--text-muted); font-weight: 500; }

  .case-hero h1 { font-size: clamp(2rem,4vw,3.5rem); background: var(--gradient-text); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: var(--space-5); }
  .case-desc    { font-size: 1.1rem; color: var(--text-dim); max-width: 680px; line-height: 1.7; margin-bottom: var(--space-5); }
  .case-tags    { display: flex; flex-wrap: wrap; gap: var(--space-2); }

  .case-body-section { background: var(--bg); }

  .case-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-16); align-items: start; }
  .case-grid.has-sidebar { grid-template-columns: 260px 1fr; }

  .case-sidebar { position: sticky; top: 100px; }
  .metrics-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-6); }
  .metrics-card h3 { font-size: .8rem; text-transform: uppercase; letter-spacing: .1em; color: var(--text-muted); font-weight: 600; margin-bottom: var(--space-5); }
  .metric-row { padding: var(--space-4) 0; border-bottom: 1px solid var(--border); }
  .metric-row:last-child { border-bottom: none; }
  .metric-value { display: block; font-size: 1.5rem; font-weight: 800; color: var(--accent-2); letter-spacing: -.02em; }
  .metric-label { display: block; font-size: .8rem; color: var(--text-muted); margin-top: 2px; }

  .prose { max-width: 680px; }
  .prose :global(h2) { font-size: 1.4rem; color: var(--text); margin-top: var(--space-12); margin-bottom: var(--space-4); padding-top: var(--space-8); border-top: 1px solid var(--border); }
  .prose :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: none; }
  .prose :global(p)  { color: var(--text-dim); line-height: 1.75; font-size: 1.025rem; margin-bottom: var(--space-5); }
  .prose :global(ul) { color: var(--text-dim); padding-left: var(--space-6); margin-bottom: var(--space-5); }
  .prose :global(li) { line-height: 1.65; margin-bottom: var(--space-2); }
  .prose :global(strong) { color: var(--text); font-weight: 600; }
  .prose :global(blockquote) { border-left: 3px solid var(--accent); padding-left: var(--space-5); margin: var(--space-8) 0; color: var(--text-dim); font-style: italic; }

  .case-cta { background: var(--surface); border-top: 1px solid var(--border); }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); flex-wrap: wrap; }
  .cta-inner h2 { font-size: 1.8rem; margin-bottom: var(--space-3); }
  .cta-inner p  { color: var(--text-muted); max-width: 400px; }

  @media (max-width: 900px) {
    .case-grid.has-sidebar { grid-template-columns: 1fr; }
    .case-sidebar { position: static; }
    .cta-inner { flex-direction: column; }
  }
</style>
