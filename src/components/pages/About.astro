---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, getPath, type Lang } from '@/i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const sv = lang === 'sv';

const traits = sv ? [
  { title: 'Systemtänkande',           desc: 'Ser helheter och beroenden snabbt. Förstår vad som faktiskt driver ett problem snarare än vad som syns på ytan.' },
  { title: 'Byggarinstinkt',           desc: 'Stannar sällan vid analysen. Det som lockar är att faktiskt förändra — bygga något som fungerar i verkligheten, inte bara i en presentation.' },
  { title: 'Organisationsförståelse',  desc: 'Förstår att lösningar behöver rätt förankring och rätt timing för att hålla. Teknik utan organisatorisk bäring fastnar i implementeringen.' },
  { title: 'Uthållighet',              desc: 'Kan bära komplexa spår länge utan att tappa riktning. Förändring tar tid, och det är okej.' },
  { title: 'Mönsterigenkänning',       desc: 'Hittar snabbt mönster i komplexitet och kan skilja på symptom och rotorsak, även när problemet är oklart formulerat.' },
  { title: 'Riktning under osäkerhet', desc: 'Fungerar väl i miljöer med hög ambiguitet. Att ta riktning och hålla den utan fullständig information är en del av arbetet.' },
] : [
  { title: 'Systems thinking',            desc: 'I see wholes and dependencies quickly — understanding what actually drives a problem rather than what appears on the surface.' },
  { title: 'Builder instinct',            desc: "I rarely stop at the analysis. What draws me is actually changing things — building something that works in reality, not just in a presentation." },
  { title: 'Organisational fluency',      desc: 'Solutions need the right anchoring and timing to hold. Technology without organisational backing stalls in implementation.' },
  { title: 'Persistence',                 desc: "I can carry complex tracks for a long time without losing direction. Change takes time, and that's fine." },
  { title: 'Pattern recognition',         desc: "I find patterns in complexity quickly and can separate symptoms from root causes, even when the problem is poorly framed." },
  { title: 'Direction under uncertainty', desc: 'I function well in high-ambiguity environments. Taking a direction and holding it without complete information is part of the work.' },
];

const proofPoints = sv ? [
  { title: 'Från symptom till struktur',  desc: 'Jag börjar med varför problemet uppstår, inte vad som syns på ytan. Det ger lösningar som inte behöver göras om nästa kvartal.' },
  { title: 'Förändring som bär över tid', desc: 'Jag bygger för att det ska hålla — i arbetssättet, i organisationen, i tekniken. Inte för att det ska se bra ut i nästa statusrapport.' },
  { title: 'Teknik möter vardag',         desc: 'De bästa systemen är de som faktiskt används. Jag bygger i skärningen där teknik, processer och människors faktiska behov möts.' },
] : [
  { title: 'From symptom to structure', desc: "I start with why the problem arises, not what's visible on the surface. That produces solutions that don't need redoing next quarter." },
  { title: 'Change that lasts',          desc: 'I build for durability — in the way of working, in the organisation, in the technology. Not to look good in the next status report.' },
  { title: 'Technology meets reality',   desc: "The best systems are the ones that actually get used. I build at the intersection where technology, processes, and people's real needs converge." },
];

const forwardItems = sv ? [
  'Teknisk strategi och systemförändring',
  'Komplex leverans- och förändringsledning',
  'Plattforms- och arkitekturansvar',
  'På sikt en egen praktik byggd på verklig systemförståelse',
] : [
  'Technical strategy and systems change',
  'Complex delivery and change leadership',
  'Platform and architecture ownership',
  'Eventually, an independent practice built on genuine systems understanding',
];

const timeline = sv ? [
  {
    role:    'IT Object Leader',
    org:     'Saab',
    period:  'Juni 2026 – nu',
    sector:  'Försvar & flyg',
    summary: 'Ansvarar för styrning och vidareutveckling av specialiserade IT-miljöer i försvarsindustrin. Samordnar prioriteringar, arkitektur, säkerhet, livscykel och leverans i en verksamhet med höga krav på robusthet och kontroll.',
  },
  {
    role:    'Team- & projektledare',
    org:     'Domstolsverket',
    period:  'Oktober 2025 – Juni 2026',
    sector:  'Offentlig sektor',
    summary: 'Äger och prioriterar verksamhetskritiska digitala plattformar med långsiktig påverkan på organisationens stabilitet. Ansvarar för styrning, arkitekturval, riskhantering och färdplan i komplexa miljöer med höga krav på säkerhet och tillgänglighet.',
  },
  {
    role:    'Delägare',
    org:     'Norumi AB',
    period:  'Januari 2025 – nu',
    sector:  'IT-rådgivning',
    summary: 'Medgrundare av initiativ inom strategisk IT-rådgivning och ägarredo digitalisering. Fokus på AI, automation och plattformstänk som värdedrivare för organisationer som vill växa eller konsolidera.',
  },
  {
    role:    'Team- & projektledare',
    org:     'Domstolsverket',
    period:  'Maj 2023 – Oktober 2025',
    sector:  'Offentlig sektor',
    summary: 'Ledde team inom digitala plattformar och identitets- och åtkomsthantering (IAM). Samordning och leverans i miljöer med höga krav på säkerhet, efterlevnad och kontinuitet.',
  },
  {
    role:    'Teamledare & systemtekniker',
    org:     'Domstolsverket',
    period:  'April 2021 – Maj 2023',
    sector:  'Offentlig sektor',
    summary: 'Kombinerade tekniskt ansvar med teamledning och förbättringsarbete. Bidrog till ökad stabilitet, standardisering och effektivitet i digitala lösningar.',
  },
  {
    role:    'Junior systemtekniker',
    org:     'Domstolsverket',
    period:  'Augusti 2020 – April 2021',
    sector:  'Offentlig sektor',
    summary: 'Drift, felsökning och vidareutveckling av centrala IT-tjänster. Byggde grund inom informationssäkerhet och systemförvaltning i en komplex offentlig organisation.',
  },
  {
    role:    'Nätverkstekniker / ingenjör',
    org:     'Telia Company',
    period:  '2018 – 2019',
    sector:  'Telekom',
    summary: 'Nätverksleverans för internationella företagskunder med höga krav på säkerhet och tillgänglighet.',
  },
] : [
  {
    role:    'IT Object Leader',
    org:     'Saab',
    period:  'June 2026 – Present',
    sector:  'Defence & aerospace',
    summary: 'Leads the governance and development of specialised IT environments in the defence industry, aligning priorities, architecture, security, lifecycle management, and delivery in a high-assurance setting.',
  },
  {
    role:    'Team & Project Manager',
    org:     'Domstolsverket',
    period:  'October 2025 – June 2026',
    sector:  'Public sector',
    summary: 'Owns and prioritises mission-critical digital platforms with long-term impact on organisational stability. Responsible for governance, architecture decisions, risk management, and roadmap in high-security environments.',
  },
  {
    role:    'Co-owner',
    org:     'Norumi AB',
    period:  'January 2025 – Present',
    sector:  'IT Advisory',
    summary: 'Co-founded a strategic IT advisory initiative focused on AI, automation, and platform thinking — helping organisations treat IT as a value driver, not a cost centre.',
  },
  {
    role:    'Team & Project Manager',
    org:     'Domstolsverket',
    period:  'May 2023 – October 2025',
    sector:  'Public sector',
    summary: 'Led teams across digital platforms and identity & access management (IAM). Coordinated delivery in environments with strict security, compliance, and continuity requirements.',
  },
  {
    role:    'Team Lead & Systems Engineer',
    org:     'Domstolsverket',
    period:  'April 2021 – May 2023',
    sector:  'Public sector',
    summary: 'Combined technical ownership with team leadership and improvement work. Drove stability, standardisation, and efficiency across digital services.',
  },
  {
    role:    'Junior Systems Engineer',
    org:     'Domstolsverket',
    period:  'August 2020 – April 2021',
    sector:  'Public sector',
    summary: 'Operations, troubleshooting, and development of core IT services. Built foundations in information security and system management within a large public-sector organisation.',
  },
  {
    role:    'Network Technician / Engineer',
    org:     'Telia Company',
    period:  '2018 – 2019',
    sector:  'Telecom',
    summary: 'Network delivery for international enterprise customers with strict security and uptime requirements.',
  },
];

const certifications = [
  { name: 'CCNA Routing and Switching: Introduction to Networks',         issuer: 'Cisco',                              year: '2017' },
  { name: 'CCNA Routing and Switching: Routing and Switching Essentials', issuer: 'Cisco',                              year: '2018' },
  { name: 'Professional Scrum Master I (PSM I)',                           issuer: 'Scrum.org',                          year: '2019' },
  { name: 'Python Advanced',                                               issuer: 'Programing Hub',                     year: '2020' },
  { name: 'Fundamentals of Business Certificate',                          issuer: 'Smartly (Pedago LLC)',               year: '2020' },
  {
    name:   sv ? 'ISO/IEC 27001 — kandidatuppsats (publikation)' : 'ISO/IEC 27001 Research Publication',
    issuer: 'Jönköping University · Secify',
    year:   '2020',
  },
];

const skills = [
  {
    group: sv ? 'Leverans & metodik'    : 'Delivery & Methods',
    items: sv
      ? ['Programledning', 'Agilt arbetssätt / SAFe', 'PRINCE2', 'Riskhantering', 'Förändringsledning']
      : ['Program Management', 'Agile / SAFe', 'PRINCE2', 'Risk Management', 'Change Management'],
  },
  {
    group: sv ? 'Ledarskap & strategi'  : 'Leadership & Strategy',
    items: sv
      ? ['Tekniskt ledarskap', 'Intressenthantering', 'IT-strategi', 'Digital transformation', 'Teambyggande']
      : ['Technical Leadership', 'Stakeholder Management', 'IT Strategy', 'Digital Transformation', 'Team Building'],
  },
  {
    group: sv ? 'Teknik & plattformar' : 'Technology & Platforms',
    items: sv
      ? ['AI-/ML-lösningar', 'Enterprise-arkitektur', 'Moln och lokala miljöer', 'Plattformsdrift', 'Systemintegration']
      : ['AI / ML Solutions', 'Enterprise Architecture', 'Cloud & On-Premises', 'Platform Operations', 'Systems Integration'],
  },
  {
    group: sv ? 'Språk' : 'Languages',
    items: sv
      ? ['Svenska — modersmål', 'Engelska — C2', 'Spanska — A1']
      : ['Swedish — native', 'English — C2', 'Spanish — A1'],
  },
];

const education = sv ? [
  {
    degree:  'Kandidatexamen: IT-infrastruktur & nätverksdesign',
    org:     'Jönköping University (JTH)',
    period:  '2017 – 2020',
    summary: 'Tvärdisciplinär utbildning: IT Management, nätverks- och serverdesign samt verksamhetsnära IT-utveckling. Fördjupning i nätverksarkitektur, virtualisering, molntjänster (Azure, AWS), IT-infrastruktur (VMware, Linux, Windows Server) och Python.',
  },
] : [
  {
    degree:  "Bachelor's: IT Infrastructure & Network Design",
    org:     'Jönköping University (JTH)',
    period:  '2017 – 2020',
    summary: 'Cross-disciplinary programme spanning IT management, network and server design, and applied IT development. Depth in network architecture, virtualisation, cloud (Azure, AWS), infrastructure (VMware, Linux, Windows Server), and Python.',
  },
];
---
<BaseLayout
  lang={lang}
  title={`${t('about.page.label')} — Emil Freijd`}
  description={sv
    ? 'Bakgrund, erfarenhet och arbetssätt. Emil Freijd — IT Object Leader inom styrning, arkitektur och leverans.'
    : 'Background, experience, and approach. Emil Freijd — IT Object Leader across governance, architecture, and delivery.'}
>

  <div class="page-hero">
    <div class="container">
      <p class="section-label">{t('about.page.label')}</p>
      <h1>{t('about.page.heading')}</h1>
      <p>{t('about.page.intro')}</p>
    </div>
  </div>

  <!-- BIO -->
  <section class="bio-section">
    <div class="container">
      <div class="bio-grid">
        <div class="bio-text">
          <p class="section-label">{t('about.story.label')}</p>
          <h2>{t('about.story.heading')}</h2>
          {sv ? (
            <p>Jag arbetar i miljöer där teknik och organisation måste hänga ihop — och där förståelse för helheten är en förutsättning för att förändra enskilda delar. Det som driver mig är komplexa problem som kräver både systemtänkande och faktisk genomförandekraft. Inte ett eller annat.</p>
          ) : (
            <p>I work in environments where technology and organisation must connect — where understanding the whole is a prerequisite for changing any individual part. What drives me is complex problems that require both systems thinking and genuine delivery capability. Not one or the other.</p>
          )}
          <a href={getPath(lang, 'contact')} class="btn btn-ghost" style="display:inline-flex;margin-top:2rem;">{t('about.cta')}</a>
        </div>
        <div class="bio-aside">
          <div class="bio-current">
            <p class="section-label">{sv ? 'Nuvarande uppdrag' : 'Current remit'}</p>
            <h3>IT Object Leader</h3>
            <p class="bio-current-org">Saab · {sv ? 'Försvar och flyg' : 'Defence and aerospace'}</p>
            <p>{sv
              ? 'Styrning, arkitektur och livscykelleverans för specialiserade IT-miljöer där robusthet och tydligt ägarskap är avgörande.'
              : 'Governance, architecture, and lifecycle delivery for specialised IT environments where resilience and explicit ownership are essential.'}</p>
          </div>
          <div class="bio-cv">
            <p class="bio-cv-note">{t('about.cv.note')} <a href={getPath(lang, 'contact')}>{t('about.cv.link')}</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW I WORK -->
  <section class="traits-section">
    <div class="container">
      <p class="section-label">{t('about.howIWork.label')}</p>
      <h2>{t('about.howIWork.heading')}</h2>
      <div class="traits-grid">
        {traits.map((trait, i) => (
          <div class="trait-card" data-reveal>
            <span class="trait-num">0{i + 1}</span>
            <h3>{trait.title}</h3>
            <p>{trait.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- APPROACH -->
  <section class="approach-section">
    <div class="container">
      <p class="section-label">{t('about.approach.label')}</p>
      <h2>{t('about.approach.heading')}</h2>
      <div class="proof-list">
        {proofPoints.map(point => (
          <div class="proof-card" data-reveal>
            <h3>{point.title}</h3>
            <p>{point.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT I WANT TO BUILD -->
  <section class="forward-section">
    <div class="container">
      <div class="forward-grid">
        <div class="forward-text">
          <p class="section-label">{t('about.forward.label')}</p>
          <h2>{t('about.forward.heading')}</h2>
          {sv ? (
            <p>Lockas av verkligt svåra problem och av att bygga något med verklig betydelse. Det handlar mindre om att maximera storlek till varje pris och mer om att skapa något skarpt, användbart och värdigt min kapacitet.</p>
          ) : (
            <p>I'm drawn to genuinely difficult problems and building things that matter. Less about maximising scale at any cost, more about creating something sharp, useful, and worthy of what I can do.</p>
          )}
        </div>
        <ul class="forward-list">
          {forwardItems.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="values-section">
    <div class="container">
      <div class="values-inner">
        <p class="section-label">{t('about.values.label')}</p>
        <h2>{t('about.values.heading')}</h2>
        {sv ? (
          <p class="values-body">Jag vill inte bara bygga professionellt starka saker. Jag vill också leva på ett sätt som går att respektera: med familj, närvaro, riktning och ett vardagsliv som faktiskt känns stort. Ambition och närvaro är inte motsatser — de förstärker varandra när man bygger rätt saker.</p>
        ) : (
          <p class="values-body">I don't just want to build professionally strong things. I want to live in a way that's worth respecting too — with family, presence, direction, and a daily life that actually feels large. Ambition and presence aren't opposites. They reinforce each other when you're building the right things.</p>
        )}
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="timeline-section">
    <div class="container">
      <p class="section-label">{t('about.career.label')}</p>
      <h2>{t('about.career.heading')}</h2>
      <div class="timeline">
        {timeline.map(item => (
          <div class="timeline-item" data-reveal>
            <div class="timeline-dot"></div>
            <div class="timeline-body">
              <div class="timeline-header">
                <div>
                  <h3>{item.role}</h3>
                  <span class="timeline-org">{item.org}</span>
                </div>
                <div class="timeline-meta">
                  <span class="timeline-period">{item.period}</span>
                  <span class="tag">{item.sector}</span>
                </div>
              </div>
              <p class="timeline-summary">{item.summary}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section class="skills-section">
    <div class="container">
      <p class="section-label">{t('about.skills.label')}</p>
      <h2>{t('about.skills.heading')}</h2>
      <div class="skills-grid">
        {skills.map(g => (
          <div class="skills-group" data-reveal>
            <h3>{g.group}</h3>
            <div class="skills-tags">{g.items.map(s => <span class="tag">{s}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EDUCATION -->
  <section class="education-section">
    <div class="container">
      <p class="section-label">{t('about.education.label')}</p>
      <h2>{t('about.education.heading')}</h2>
      <div class="edu-list">
        {education.map(e => (
          <div class="edu-card" data-reveal>
            <div class="edu-header">
              <h3>{e.degree}</h3>
              <span class="edu-period">{e.period}</span>
            </div>
            <span class="edu-org">{e.org}</span>
            <p class="edu-summary">{e.summary}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CERTS -->
  <section class="certs-section">
    <div class="container">
      <p class="section-label">{t('about.certs.label')}</p>
      <h2>{t('about.certs.heading')}</h2>
      <div class="certs-grid">
        {certifications.map(c => (
          <div class="cert-card" data-reveal>
            <span class="cert-name">{c.name}</span>
            <span class="cert-meta">{c.issuer} · {c.year}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Bio */
  .bio-section { background: var(--bg); }
  .bio-grid { display: grid; grid-template-columns: 1fr 300px; gap: var(--space-16); align-items: start; }
  .bio-text h2 { margin-bottom: var(--space-6); }
  .bio-text p  { color: var(--text-dim); line-height: 1.75; font-size: 1.025rem; margin-bottom: var(--space-5); }
  .bio-aside   { display: flex; flex-direction: column; gap: var(--space-6); }
  .bio-current { border-top:2px solid var(--accent);border-bottom:1px solid var(--border);padding:var(--space-6) 0; }
  .bio-current h3 { font-family:var(--font-display);font-size:2rem;font-weight:600;margin-bottom:var(--space-1); }
  .bio-current-org { color:var(--accent-2) !important;font-size:.8rem !important;font-weight:600;letter-spacing:.06em;text-transform:uppercase;margin-bottom:var(--space-5) !important; }
  .bio-cv-note { font-size: .85rem; color: var(--text-muted); }
  .bio-cv-note a { color: var(--accent-2); border-bottom: 1px solid rgba(167,139,250,.3); }

  /* Traits */
  .traits-section { background: var(--surface); }
  .traits-section h2 { margin-bottom: var(--space-10); }
  .traits-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  .trait-card {
    background: transparent;
    border: none;
    border-top: 1px solid var(--border);
    border-radius: 0;
    padding: var(--space-6) 0;
    transition: border-color var(--transition);
  }
  .trait-card:hover { border-color: rgba(124,106,247,.3); }
  .trait-num {
    display: block;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .1em;
    color: var(--accent-2);
    opacity: .5;
    margin-bottom: var(--space-3);
  }
  .trait-card h3 { font-size: .95rem; margin-bottom: var(--space-3); }
  .trait-card p  { font-size: .875rem; color: var(--text-muted); line-height: 1.65; }

  /* Approach */
  .approach-section { background: var(--bg); }
  .approach-section h2 { margin-bottom: var(--space-10); }
  .proof-list { display: flex; flex-direction: column; gap: var(--space-4); }
  .proof-card {
    padding: var(--space-6) var(--space-8);
    border-left: 2px solid var(--accent-2);
    background: var(--surface);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .proof-card h3 { font-size: 1rem; margin-bottom: var(--space-2); }
  .proof-card p  { font-size: .9rem; color: var(--text-muted); line-height: 1.65; }

  /* Looking ahead */
  .forward-section { background: var(--surface); }
  .forward-section h2 { margin-bottom: var(--space-6); }
  .forward-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }
  .forward-text p { color: var(--text-dim); line-height: 1.75; font-size: 1rem; margin-top: var(--space-5); }
  .forward-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .forward-list li {
    padding: var(--space-4) var(--space-5);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: .925rem;
    color: var(--text-dim);
  }

  /* Values */
  .values-section { background: var(--bg); }
  .values-inner { max-width: 680px; }
  .values-inner h2 { margin-bottom: var(--space-6); }
  .values-body { font-size: 1.05rem; color: var(--text-dim); line-height: 1.85; }

  /* Timeline */
  .timeline-section { background: var(--surface); }
  .timeline-section h2 { margin-bottom: var(--space-12); }
  .timeline { display: flex; flex-direction: column; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 11px; top: 0; bottom: 0; width: 1px; background: var(--border); }
  .timeline-item { display: flex; gap: var(--space-8); padding-bottom: var(--space-10); position: relative; }
  .timeline-item:last-child { padding-bottom: 0; }
  .timeline-dot { width: 23px; height: 23px; min-width: 23px; border-radius: 50%; background: var(--surface-2); border: 2px solid var(--accent); margin-top: 2px; position: relative; z-index: 1; }
  .timeline-body { flex: 1; }
  .timeline-header { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-3); }
  .timeline-header h3 { font-size: 1.05rem; }
  .timeline-org    { font-size: .875rem; color: var(--accent-2); font-weight: 500; display: block; margin-top: 2px; }
  .timeline-meta   { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-2); }
