---
import { useTranslations, getPath, getOtherLangPath, type Lang } from '@/i18n/utils';

interface Props { lang: Lang; otherLangHref?: string; }
const { lang, otherLangHref: otherLangHrefOverride } = Astro.props;
const t    = useTranslations(lang);

const links = [
  { key: 'nav.about', path: 'about' },
  { key: 'nav.stream', path: 'stream' },
  { key: 'nav.contact', path: 'contact' },
] as const;

const otherLangHref  = otherLangHrefOverride ?? getOtherLangPath(Astro.url);
const otherLangLabel = t('lang.label');

const home = getPath(lang, '');
const path = Astro.url.pathname;
const isActive = (href: string) => (href === home ? path === href : path.startsWith(href));
---
<nav id="nav">
  <div class="nav-inner">
    <a href={getPath(lang, '')} class="nav-logo" data-local-path="">EF</a>

    <ul class="nav-links">
      {links.map(l => (
        <li>
          <a href={getPath(lang, l.path)} data-local-path={l.path} data-i18n={l.key} class:list={{ active: isActive(getPath(lang, l.path)) }} aria-current={isActive(getPath(lang, l.path)) ? 'page' : undefined}>
            {t(l.key)}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-controls">
      <!-- Language switcher -->
      <a href={otherLangHref} class="nav-lang" title={otherLangLabel}>
        {lang === 'en' ? 'SV' : 'EN'}
      </a>

      <!-- Theme toggle -->
      <button type="button" class="nav-theme" id="theme-toggle">
        <span class="theme-label theme-to-light" data-i18n="a11y.theme.light">{t('a11y.theme.light')}</span>
        <span class="theme-label theme-to-dark" data-i18n="a11y.theme.dark">{t('a11y.theme.dark')}</span>
        <svg class="theme-to-light" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="theme-to-dark" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>

      <!-- Mobile burger -->
      <button class="nav-burger" aria-label={t('a11y.menu')} data-i18n-label="a11y.menu" aria-expanded="false" aria-haspopup="dialog" aria-controls="mobile-navigation">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <dialog class="nav-mobile" id="mobile-navigation" aria-label={t('a11y.menu.title')} data-i18n-label="a11y.menu.title">
    <div class="nav-panel">
      <button class="nav-close" type="button" autofocus data-i18n="a11y.menu.close">{t('a11y.menu.close')}</button>
      <ul class="nav-mobile-links">
        {links.map(l => (
          <li>
            <a href={getPath(lang, l.path)} data-local-path={l.path} data-i18n={l.key} class:list={{ active: isActive(getPath(lang, l.path)) }} aria-current={isActive(getPath(lang, l.path)) ? 'page' : undefined}>
              {t(l.key)}
            </a>
          </li>
        ))}
      </ul>
      <a href={otherLangHref} class="nav-lang">{otherLangLabel}</a>
    </div>
  </dialog>
</nav>

<style>
  #nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    transition: background var(--transition), border-bottom var(--transition);
    border-bottom: 1px solid transparent;
  }
  #nav.scrolled {
    background: var(--nav-scrolled);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--border);
  }
  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.25rem var(--space-8);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }
  .nav-logo {
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.05em;
    color: var(--accent-text);
    flex-shrink: 0;
  }
  .nav-links {
    list-style: none;
    display: flex;
    gap: 2.5rem;
    flex: 1;
    justify-content: center;
  }
  .nav-links a {
    position: relative;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-dim);
    transition: color var(--transition);
  }
  .nav-links a:hover { color: var(--text); }
  .nav-links a.active { color: var(--text); }
  .nav-links a.active::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -7px;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
  }

  .nav-controls {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .nav-lang {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    color: var(--text-muted);
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: all var(--transition);
  }
  .nav-lang:hover { color: var(--accent-2); border-color: rgba(124,106,247,0.3); }

  .nav-theme {
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    width: 34px; height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--text-muted);
    transition: all var(--transition);
  }
  .nav-theme:hover { color: var(--accent-2); border-color: rgba(124,106,247,0.3); }

  .theme-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  :global(html[data-theme="dark"]) .theme-to-dark,
  :global(html[data-theme="light"]) .theme-to-light,
  :global(html:not(.js)) .nav-theme { display: none; }

  .nav-burger {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
  }
  .nav-burger span {
    display: block;
    width: 22px; height: 2px;
    background: var(--text-dim);
    border-radius: 2px;
    transition: all var(--transition);
  }

  .nav-mobile {
    inset: 0 0 auto;
    width: 100%;
    max-width: none;
    max-height: 100vh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    color: var(--text);
    background: var(--surface);
    border: 0;
    border-bottom: 1px solid var(--border);
  }
  .nav-mobile::backdrop { background: rgba(0, 0, 0, 0.6); }
  :global(html:has(#mobile-navigation[open])) { overflow: hidden; }
  .nav-panel { max-width: 36rem; margin: 0 auto; padding: var(--space-4) var(--space-8) var(--space-8); }
  .nav-close {
    display: block;
    min-height: 44px;
    margin-left: auto;
    padding: 0 var(--space-4);
    font: inherit;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .nav-mobile-links { list-style: none; margin: var(--space-4) 0; }
  .nav-panel a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2);
    color: var(--text-dim);
  }
  .nav-panel a:hover, .nav-panel a.active { color: var(--accent-2); }
  .nav-panel .nav-lang { width: fit-content; }

  @media (max-width: 640px) {
    :global(html:not(.js)) #nav { position: relative; }
    .nav-inner { flex-wrap: wrap; gap: var(--space-3); }
    .nav-links { flex: 0 0 100%; order: 1; justify-content: flex-start; gap: var(--space-5); }
    :global(html.js) .nav-links { display: none; }
    :global(html.js) .nav-burger { display: flex; }
  }
</style>

<script>
  let navEvents: AbortController | undefined;

  function initNav() {
    navEvents?.abort();
    navEvents = new AbortController();
    const { signal } = navEvents;
    const nav = document.getElementById('nav');
    const burger = nav?.querySelector<HTMLButtonElement>('.nav-burger');
    const drawer = nav?.querySelector<HTMLDialogElement>('.nav-mobile');
    const toggle = nav?.querySelector<HTMLButtonElement>('#theme-toggle');
    if (!nav || !burger || !drawer) return;

    burger.addEventListener('click', () => {
      drawer.showModal();
      burger.setAttribute('aria-expanded', 'true');
    }, { signal });
    drawer.addEventListener('close', () => {
      burger.setAttribute('aria-expanded', 'false');
    }, { signal });
    drawer.addEventListener('click', event => {
      const target = event.target;
      if (target === drawer || (target instanceof Element && target.closest('.nav-close, a'))) {
        drawer.close();
      }
    }, { signal });
    window.matchMedia('(min-width: 641px)').addEventListener('change', event => {
      if (event.matches && drawer.open) drawer.close();
    }, { signal });
    document.addEventListener('astro:before-swap', () => {
      if (drawer.open) drawer.close();
    }, { signal });

    toggle?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next    = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#080810' : '#f4f5fb');
      try {
        localStorage.setItem('theme', next);
      } catch {
        // The selected theme still applies for the current page.
      }
    }, { signal });
  }

  function updateNavScroll() {
    const nav = document.getElementById('nav');
    if (nav) nav.classList.toggle('scrolled', window.scrollY > 40);
  }

  document.addEventListener('astro:page-load', () => {
    initNav();
    updateNavScroll();
  });

  window.addEventListener('scroll', updateNavScroll, { passive: true });
</script>
