---
import { useTranslations, getPath, getOtherLangPath, type Lang } from '@/i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t    = useTranslations(lang);

const links = [
  { label: t('nav.about'),   href: getPath(lang, 'about')  },
  { label: t('nav.stream'),  href: getPath(lang, 'stream') },
  { label: t('nav.contact'), href: getPath(lang, 'contact')},
];

const otherLangHref  = getOtherLangPath(Astro.url);
const otherLangLabel = t('lang.label');

const home = getPath(lang, '');
const path = Astro.url.pathname;
const isActive = (href: string) => (href === home ? path === href : path.startsWith(href));
---
<nav id="nav">
  <div class="nav-inner">
    <a href={getPath(lang, '')} class="nav-logo">EF</a>

    <ul class="nav-links">
      {links.map(l => (
        <li>
          <a href={l.href} class:list={{ active: isActive(l.href) }} aria-current={isActive(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-controls">
      <!-- Language switcher -->
      <a href={otherLangHref} class="nav-lang" title={otherLangLabel}>
        {lang === 'en' ? 'SV' : 'EN'}
      </a>

      <!-- Theme toggle -->
      <button class="nav-theme" id="theme-toggle" aria-label={t('a11y.theme')}>
        <!-- Sun (shown in dark mode) -->
        <svg aria-hidden="true" class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <!-- Moon (shown in light mode) -->
        <svg aria-hidden="true" class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>

      <!-- Mobile burger -->
      <button class="nav-burger" aria-label={t('a11y.menu')} aria-expanded="false" aria-controls="mobile-navigation">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="nav-backdrop"></div>
  <div class="nav-mobile" id="mobile-navigation" aria-hidden="true" inert>
    {links.map(l => <a href={l.href} class:list={{ active: isActive(l.href) }} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>)}
    <div class="nav-mobile-meta">
      <a href={otherLangHref} class="nav-lang">{otherLangLabel}</a>
    </div>
  </div>
</nav>

<style>
  #nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    transition: background var(--transition), border-bottom var(--transition);
    border-bottom: 1px solid transparent;
  }
  #nav.scrolled {
    background: var(--nav-scrolled);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--border);
  }
  .nav-inner {
    position: relative;
    z-index: 3;
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.25rem var(--space-8);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }
  .nav-logo {
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.05em;
    color: var(--accent-2);
    flex-shrink: 0;
  }
  .nav-links {
    list-style: none;
    display: flex;
    gap: 2.5rem;
    flex: 1;
    justify-content: center;
  }
  .nav-links a {
    position: relative;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-dim);
    transition: color var(--transition);
  }
  .nav-links a:hover { color: var(--text); }
  .nav-links a.active { color: var(--text); }
  .nav-links a.active::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -7px;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
  }

  .nav-controls {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .nav-lang {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    color: var(--text-muted);
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: all var(--transition);
  }
  .nav-lang:hover { color: var(--accent-2); border-color: rgba(124,106,247,0.3); }

  .nav-theme {
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    width: 34px; height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--text-muted);
    transition: all var(--transition);
  }
  .nav-theme:hover { color: var(--accent-2); border-color: rgba(124,106,247,0.3); }

  /* Show correct icon per theme */
  [data-theme="dark"]  .icon-moon { display: none; }
  [data-theme="light"] .icon-sun  { display: none; }

  .nav-burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
  }
  .nav-burger span {
    display: block;
    width: 22px; height: 2px;
    background: var(--text-dim);
    border-radius: 2px;
    transition: all var(--transition);
  }

  .nav-mobile {
    display: none;
  }
  .nav-backdrop { display:none; }
  .nav-mobile a {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-dim);
    padding: var(--space-2) 0;
    transition: color var(--transition);
  }
  .nav-mobile a:hover { color: var(--text); }
  .nav-mobile a.active { color: var(--accent-2); }
  .nav-mobile-meta {
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }
  .nav-mobile-meta .nav-lang { font-size: 0.85rem; }

  @media (max-width: 640px) {
    .nav-links  { display: none; }
    .nav-burger { display: flex; }
    #nav.menu-open .nav-inner { background:var(--nav-scrolled);backdrop-filter:blur(14px);border-bottom:1px solid var(--border); }
    .nav-backdrop { display:block;position:fixed;inset:0;z-index:1;background:rgba(3,3,8,.72);opacity:0;visibility:hidden;pointer-events:none;transition:opacity var(--transition),visibility var(--transition); }
    .nav-backdrop.open { opacity:1;visibility:visible;pointer-events:auto; }
    .nav-mobile { display:flex;position:fixed;z-index:2;top:74px;right:0;bottom:0;width:min(88vw,380px);padding:var(--space-10) var(--space-8);flex-direction:column;gap:var(--space-4);background:var(--surface);border-left:1px solid var(--border);transform:translateX(100%);visibility:hidden;transition:transform var(--transition),visibility var(--transition);overflow-y:auto; }
    .nav-mobile.open { transform:translateX(0);visibility:visible; }
    .nav-mobile a { display:flex;align-items:center;min-height:48px;font-family:var(--font-display);font-size:1.65rem;font-weight:550; }
    .nav-mobile-meta .nav-lang { font-family:var(--font-body);font-size:.85rem;display:inline-flex;min-height:40px; }
    .nav-burger[aria-expanded="true"] span:nth-child(1) { transform:translateY(7px) rotate(45deg); }
    .nav-burger[aria-expanded="true"] span:nth-child(2) { opacity:0; }
    .nav-burger[aria-expanded="true"] span:nth-child(3) { transform:translateY(-7px) rotate(-45deg); }
  }
</style>

<script>
  // Per-page elements are swapped on view-transition navigation, so (re)bind
  // their listeners on every astro:page-load. The window-level scroll listener
  // is bound once and survives navigations.
  function initNav() {
    const nav    = document.getElementById('nav');
    if (!nav) return;
    const burger = nav.querySelector('.nav-burger') as HTMLButtonElement | null;
    const drawer = nav.querySelector('.nav-mobile') as HTMLElement | null;
    const backdrop = nav.querySelector('.nav-backdrop') as HTMLElement | null;
    const toggle = document.getElementById('theme-toggle') as HTMLButtonElement | null;

    const setMenu = (open: boolean, returnFocus = false) => {
      nav.classList.toggle('menu-open', open);
      drawer?.classList.toggle('open', open);
      backdrop?.classList.toggle('open', open);
      drawer?.setAttribute('aria-hidden', String(!open));
      if (drawer) drawer.inert = !open;
      burger?.setAttribute('aria-expanded', String(open));
      document.body.classList.toggle('menu-open', open);
      if (open) drawer?.querySelector<HTMLAnchorElement>('a')?.focus();
      if (!open && returnFocus) burger?.focus();
    };

    burger?.addEventListener('click', () => {
      setMenu(burger.getAttribute('aria-expanded') !== 'true');
    });

    backdrop?.addEventListener('click', () => setMenu(false, true));
    drawer?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setMenu(false)));

    nav.addEventListener('keydown', event => {
      if (event.key === 'Escape' && drawer?.classList.contains('open')) {
        setMenu(false, true);
      }
      if (event.key === 'Tab' && drawer?.classList.contains('open')) {
        const focusable = [burger, ...drawer.querySelectorAll<HTMLElement>('a, button')].filter(Boolean) as HTMLElement[];
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    const desktop = window.matchMedia('(min-width: 641px)');
    const controller = new AbortController();
    desktop.addEventListener('change', event => event.matches && setMenu(false), { signal: controller.signal });
    document.addEventListener('astro:before-swap', () => {
      setMenu(false);
      controller.abort();
    }, { once: true });

    toggle?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next    = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#080810' : '#f4f5fb');
      try {
        localStorage.setItem('theme', next);
      } catch {
        // The selected theme still applies for the current page.
      }
    });
  }

  function updateNavScroll() {
    const nav = document.getElementById('nav');
    if (nav) nav.classList.toggle('scrolled', window.scrollY > 40);
  }

  document.addEventListener('astro:page-load', () => {
    initNav();
    updateNavScroll();
  });

  if (!(window as any).__navScrollBound) {
    window.addEventListener('scroll', updateNavScroll, { passive: true });
    (window as any).__navScrollBound = true;
  }
</script>
