---
import { raciText } from '@/i18n/translations';
import type { Lang } from '@/i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const text = raciText[lang];
---
<raci-matrix data-lang={lang} id="matrix">
  <section aria-labelledby="matrix-title">
    <div class="matrix-intro">
      <h2 id="matrix-title">{text['tool-title']}</h2>
      <p>{text['tool-intro']}</p>
    </div>
    <noscript><p>{text.fallback}</p></noscript>
    <div id="matrix-interactive" hidden>
      <div class="controls">
        <div class="control-group">
          <button type="button" id="example">{text.example}</button>
          <button type="button" id="blank">{text.blank}</button>
        </div>
      </div>
      <ul id="matrix-legend" class="legend"></ul>
      <p id="matrix-scroll-hint" class="scroll-hint" hidden>{text.scrollHint}</p>
      <div class="matrix-scroll" tabindex="0" role="region" aria-labelledby="matrix-title" id="matrix-scroll">
        <table id="grid">
          <thead></thead>
          <tbody></tbody>
        </table>
      </div>
      <div class="controls">
        <div class="control-group">
          <button type="button" id="add-row">{text['add-row']}</button>
          <button type="button" id="add-role">{text['add-role']}</button>
        </div>
        <button type="button" id="export">{text.export}</button>
      </div>
      <div class="matrix-feedback">
        <p id="status" role="status"></p>
        <p id="matrix-privacy" class="privacy">{text.privacy}</p>
      </div>
    </div>
  </section>
</raci-matrix>

<script>
  import '@/scripts/raci-matrix.js';
</script>

<style>
  raci-matrix {
    display: block;
    min-width: 0;
    margin: var(--space-16) auto 0;
    padding: clamp(.875rem, 3vw, 2rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    scroll-margin-top: 6rem;
  }
  raci-matrix > section { padding: 0; }
  .matrix-intro { max-width: 54ch; margin-inline: auto; text-align: center; }
  .controls, .control-group {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-2);
  }
  .controls { margin-block: var(--space-5); column-gap: var(--space-4); }
  .matrix-scroll {
    overflow: auto;
    padding: .25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    scroll-padding-inline: 10.5rem .5rem;
  }
  .matrix-scroll:focus-visible { outline: 3px solid var(--accent-text); outline-offset: 2px; }
  raci-matrix table { width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 0; }
  raci-matrix :global(th), raci-matrix :global(td) {
    width: 7.4rem;
    padding: .625rem .45rem;
    border-bottom: 1px solid var(--border);
    text-align: center;
    vertical-align: middle;
  }
  raci-matrix :global(thead th) {
    background: var(--surface-2);
    vertical-align: top;
  }
  raci-matrix :global(thead th:first-child), raci-matrix :global(thead th:last-child) {
    vertical-align: middle;
  }
  raci-matrix :global(tbody tr:last-child > *) { border-bottom: 0; }
  raci-matrix :global(th:first-child) {
    width: 10.5rem;
    position: sticky;
    inset-inline-start: 0;
    z-index: 1;
    background: var(--surface-2);
    box-shadow: 1px 0 var(--border);
    text-align: start;
  }
  raci-matrix :global(button), raci-matrix :global(textarea), raci-matrix :global(select) {
    min-height: 2.5rem;
    padding: .25rem .5rem;
    border: 1px solid var(--text-muted);
    border-radius: var(--radius-sm);
    background-color: var(--surface);
    color: var(--text);
    font: inherit;
  }
  raci-matrix :global(textarea) {
    display: block;
    width: 100%;
    min-height: 3.25rem;
    max-height: 8rem;
    resize: vertical;
    overflow-wrap: anywhere;
    font-size: .925rem;
    font-weight: 600;
    line-height: 1.35;
  }
  raci-matrix :global(thead textarea) { text-align: center; }
  raci-matrix :global(select) {
    appearance: none;
    width: 4.5rem;
    max-width: 100%;
    padding-inline: .95rem;
    text-align: center;
    text-align-last: center;
    background-image: linear-gradient(45deg, transparent 50%, var(--text-dim) 50%),
      linear-gradient(135deg, var(--text-dim) 50%, transparent 50%);
    background-position: right .66rem center, right .41rem center;
    background-repeat: no-repeat;
    background-size: .25rem .25rem;
  }
  raci-matrix :global(button) { cursor: pointer; }
  #export {
    border-color: var(--accent);
    background-color: var(--accent-glow);
    font-weight: 700;
  }
  raci-matrix :global(.remove) {
    display: inline-grid;
    place-items: center;
    min-width: 1.75rem;
    min-height: 1.75rem;
    margin-top: .25rem;
    padding: 0 .25rem;
    border-color: transparent;
    background-color: transparent;
    color: var(--text-dim);
    font-size: 1.15rem;
    line-height: 1;
  }
  raci-matrix :global(.remove-row) { padding-inline: .35rem; font-size: .8rem; }
  raci-matrix :global(.remove:hover) { background-color: var(--surface-2); border-color: var(--text-muted); }
  raci-matrix :global(.row-check) { display: block; font-size: .875rem; line-height: 1.4; }
  raci-matrix .legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
    color: var(--text-dim);
    font-size: .875rem;
  }
  raci-matrix .legend :global(li) { margin: 0; }
  .scroll-hint, .privacy { color: var(--text-dim); font-size: .875rem; }
  .scroll-hint, .matrix-feedback { text-align: center; }
  #status { margin-bottom: .25rem; font-weight: 600; }
  .matrix-feedback .privacy { margin-bottom: 0; }
  @media (forced-colors: active) {
    raci-matrix :global(select) { appearance: auto; background-image: none; }
  }
  @media (max-width: 560px) {
    .matrix-scroll { scroll-padding-inline-start: 7.75rem; }
    raci-matrix :global(th), raci-matrix :global(td) { width: 7.45rem; }
    raci-matrix :global(th:first-child) { width: 7.75rem; }
    raci-matrix :global(textarea) { padding-inline: .35rem; font-size: .875rem; }
  }
</style>
