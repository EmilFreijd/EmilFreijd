---
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import { useTranslations, type Lang } from '@/i18n/utils';
import { SITE_NAME, LINKEDIN_URL } from '@/consts';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?:         string;
  description?:   string;
  lang?:          Lang;
  ogType?:        'website' | 'article';
  publishedDate?: Date;
  /** Point the canonical elsewhere (e.g. SV fallback pages → the EN original). */
  canonicalPath?: string;
  /** Override the navigation language target for pages without a translated route. */
  otherLangPath?: string;
  /** Whether this page has a genuine translated counterpart for hreflang metadata. */
  hasTranslation?: boolean;
}

const {
  title       = 'Emil Freijd — IT Leader',
  description = 'IT leader delivering platforms, teams, and technology programs in high-trust environments.',
  lang        = 'en',
  ogType      = 'website',
  publishedDate,
  canonicalPath,
  otherLangPath,
  hasTranslation = true,
} = Astro.props;

const t = useTranslations(lang);

const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImage      = new URL('/og.png', Astro.site);
const ogLocale     = lang === 'sv' ? 'sv_SE' : 'en_GB';
const ogLocaleAlt  = lang === 'sv' ? 'en_GB' : 'sv_SE';

const isSwedish = lang === 'sv';
const enPath    = isSwedish ? Astro.url.pathname.replace(/^\/sv/, '') || '/' : Astro.url.pathname;
const svPath    = isSwedish ? Astro.url.pathname : `/sv${Astro.url.pathname}`;
const enURL     = new URL(enPath, Astro.site);
const svURL     = new URL(svPath, Astro.site);
const serializeJsonLd = (value: unknown) => JSON.stringify(value).replaceAll('<', '\\u003c');
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; frame-src 'none'; upgrade-insecure-requests" />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en"      href={enURL} />
    {hasTranslation && <link rel="alternate" hreflang="sv" href={svURL} />}
    <link rel="alternate" hreflang="x-default" href={enURL} />

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:site_name"   content={SITE_NAME} />
    <meta property="og:locale"      content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:image:alt"   content="Emil Freijd — IT Leader" />
    {ogType === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate.toISOString()} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={serializeJsonLd({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Emil Freijd',
      jobTitle: 'IT Leader',
      url: 'https://emilfreijd.se',
      sameAs: [LINKEDIN_URL],
    })} />
    {ogType === 'article' && publishedDate && (
      <script is:inline type="application/ld+json" set:html={serializeJsonLd({
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description: description,
        datePublished: publishedDate.toISOString(),
        inLanguage: lang,
        author: { '@type': 'Person', name: 'Emil Freijd', url: 'https://emilfreijd.se' },
        mainEntityOfPage: canonicalURL.toString(),
        image: ogImage.toString(),
      })} />
    )}

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Emil Freijd — Stream" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Emil Freijd — Flöde" href="/sv/rss.xml" />

    <!-- Smooth client-side page transitions -->
    <ClientRouter />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#080810" />

    <!-- Theme: runs before paint to prevent flash. Also marks JS as available
         so CSS only hides reveal-animated content when it can be revealed.
         Re-applied after every view-transition swap, which replaces <html> attributes. -->
    <script is:inline>
      (function () {
        function applyTheme() {
          let stored = null;
          try {
            stored = localStorage.getItem('theme');
          } catch {
            // Storage can be unavailable in hardened browser contexts.
          }
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored === 'dark' || stored === 'light' ? stored : (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#080810' : '#f4f5fb');
          document.documentElement.classList.add('js');
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t('a11y.skip')}</a>
    <Nav lang={lang} otherLangHref={otherLangPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Scroll reveal — re-run after every (view-transition) navigation
      function initReveal() {
        const observer = new IntersectionObserver(
          entries => entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('revealed');
              observer.unobserve(e.target);
            }
          }),
          { threshold: 0.12 }
        );
        document.querySelectorAll('[data-reveal]').forEach((el, i) => {
          (el as HTMLElement).style.transitionDelay = `${(i % 3) * 0.1}s`;
          observer.observe(el);
        });
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
