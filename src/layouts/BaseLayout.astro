---
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';
import { useTranslations, type Lang } from '@/i18n/utils';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?:       string;
  description?: string;
  lang?:        Lang;
}

const {
  title       = 'Emil Freijd — IT Leader',
  description = 'IT leader delivering platforms, teams, and technology programs in high-trust environments.',
  lang        = 'en',
} = Astro.props;

const t = useTranslations(lang);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage      = new URL('/og.png', Astro.site);

const isSwedish = lang === 'sv';
const enPath    = isSwedish ? Astro.url.pathname.replace(/^\/sv/, '') || '/' : Astro.url.pathname;
const svPath    = isSwedish ? Astro.url.pathname : `/sv${Astro.url.pathname}`;
const enURL     = new URL(enPath, Astro.site);
const svURL     = new URL(svPath, Astro.site);
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en"      href={enURL} />
    <link rel="alternate" hreflang="sv"      href={svURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Emil Freijd",
        "jobTitle": "IT Leader",
        "url": "https://emilfreijd.se",
        "sameAs": ["https://www.linkedin.com/in/emilfreijd"]
      }
    </script>

    <!-- Smooth client-side page transitions -->
    <ClientRouter />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#080810" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f5fb" media="(prefers-color-scheme: light)" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Theme: runs before paint to prevent flash -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', stored || (prefersDark ? 'dark' : 'light'));
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t('a11y.skip')}</a>
    <Nav lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Scroll reveal — re-run after every (view-transition) navigation
      function initReveal() {
        const observer = new IntersectionObserver(
          entries => entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('revealed');
              observer.unobserve(e.target);
            }
          }),
          { threshold: 0.12 }
        );
        document.querySelectorAll('[data-reveal]').forEach((el, i) => {
          (el as HTMLElement).style.transitionDelay = `${(i % 3) * 0.1}s`;
          observer.observe(el);
        });
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
