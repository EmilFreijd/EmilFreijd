---
import StreamDetail from '@/components/pages/StreamDetail.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('stream', e => !e.data.draft);
  const enEntries = all.filter(e => e.data.lang !== 'sv');
  return enEntries.map(entry => {
    const svEntry = all.find(e => e.slug === `${entry.slug}-sv`);
    return { params: { slug: entry.slug }, props: { entry: svEntry ?? entry } };
  });
}

const { entry } = Astro.props;
---
<StreamDetail lang="sv" entry={entry} />
